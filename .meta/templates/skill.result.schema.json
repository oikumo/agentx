{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "omt-skill-result/v1",
  "type": "object",
  "required": ["ok", "outcome", "code", "evidence", "retryable"],
  "properties": {
    "ok": { "type": "boolean" },
    "outcome": { "type": "string", "enum": ["succeeded", "blocked", "not_applicable", "inconclusive", "failed"] },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "data": {},
    "blocker": {
      "type": "object",
      "required": ["gate", "code", "message", "requiresApproval"],
      "properties": {
        "gate": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string" },
        "requiresApproval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "retryable": { "type": "boolean" },
    "stateRevision": { "type": "string" }
  },
  "additionalProperties": false
}
