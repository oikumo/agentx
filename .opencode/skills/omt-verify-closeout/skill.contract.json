{
  "schema_version": "1",
  "id": "omt-verify-closeout",
  "version": "0.1.0",
  "mode": "procedural",
  "inputs": [
    "feature_slug"
  ],
  "requires": [
    "omt_status.preflight",
    "omt_q.state",
    "omt_nav.nav"
  ],
  "allowed_effects": [
    "read_harness_state"
  ],
  "forbidden_effects": [
