{
  "schema_version": "1",
  "id": "omt-resume-work",
  "version": "0.1.0",
  "mode": "procedural",
  "inputs": [
    "pause_pointer",
    "project_slug",
    "expected_head"
  ],
  "requires": [
    "omt_status.preflight",
    "omt_q.state",
    "omt_nav.nav"
  ],
  "allowed_effects": [
    "read_harness_state"
  ],
  "forbidden_effects": [
    "weaken_gate",
    "forge_receipt",
    "expand_scope_without_authority"
  ],
  "state_owner": "external",
  "result_schema": "omt-skill-result/v1",
  "stop_when": [
    "reconciled",
    "blocker_found",
    "authorization_required",
    "not_resumable"
  ]
}
